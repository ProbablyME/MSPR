# Variables lues par docker-compose.yml (NE PAS committer le vrai .env)
# Copier en .env puis remplir avec des valeurs réelles : cp .env.example .env

# PostgreSQL
DB_USER=postgres
DB_PASSWORD=change-me        # OBLIGATOIRE — secret BDD
DB_NAME=postgres

# API
API_TOKEN=change-me          # OBLIGATOIRE — jeton Bearer d'accès à l'API

# Frontend (jeton injecté au build ; par défaut = API_TOKEN)
VITE_API_TOKEN=change-me

# Supervision (identifiants admin — défauts: admin/admin)
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me
